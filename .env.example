# ── Discord credentials (from the Discord Developer Portal) ─────────────────
# Never commit your real .env file or share these values.
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-client-id-here

# Optional: set this to a server (guild) ID while developing.
# Guild-scoped commands register instantly. Leave empty to register
# the command globally (takes up to ~1 hour to propagate, but works
# in every server the bot is invited to).
DISCORD_GUILD_ID=

# ── Web server / keep-alive ──────────────────────────────────────────────
# Render (and most free hosts) assign this automatically. 3000 is used
# for local development.
PORT=3000

# ── Conversion limits (tune these to stay within your free host's limits) ─
# Max size of the file a user may upload, in MB, before we even try to
# download/convert it.
MAX_UPLOAD_MB=25

# Max GIF size we will try to deliver, in MB. Discord's default free-tier
# upload cap is 10MB; boosted servers allow more. Keep this <= your
# server's actual cap.
MAX_GIF_MB=10

# Max length (in seconds) of video we will convert. Longer videos are
# trimmed to this length. Keeps conversions fast on a free, shared CPU.
MAX_VIDEO_SECONDS=10

# Max number of conversions allowed to run at the same time. Keep this
# low (1-2) on free hosting tiers with limited CPU/RAM.
MAX_CONCURRENT_JOBS=2
